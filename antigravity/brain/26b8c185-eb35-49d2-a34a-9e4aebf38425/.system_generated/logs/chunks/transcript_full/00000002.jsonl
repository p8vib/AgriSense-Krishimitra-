ion: {\n      en: \"Water-soaked dark lesions with white moldy downy fungal growth on leaf undersides in high humidity.\",\n      hi: \"पत्तियों के सिरों पर पानी जैसे भीगे काले धब्बे और पत्ती के पीछे सफेद फफूंद का जाल।\",\n      as: \"পাতৰ তলফালে বগা ভেঁকুৰ আৰু পাতৰ ওপৰত ক'লা পানীৰে তিতাৰ দৰে দাগ।\",\n      es: \"Manchas oscuras húmedas con moho blanco algodonoso en el envés bajo alta humedad.\"\n    },\n    severity: \"severe\",\n    organicRemedy: {\n      en: \"Bordeaux mixture (1%) or Copper Hydroxide (2.5g/L). Remove and burn severely collapsed foliage.\",\n      hi: \"1% बोर्डो मिश्रण या कॉपर हाइड्रोक्साइड का छिड़काव करें। सड़े हुए पत्तों को जला दें।\",\n      as: \"বৰড' মিশ্ৰণ ১% ছটিয়াওক। বেয়াকৈ আক্ৰান্ত পাতবোৰ জ্বলাই দিয়ক।\",\n      es: \"Caldo bordelés al 1% o hidróxido de cobre. Eliminar focos iniciales.\"\n    },\n    chemicalTreatment: {\n      en: \"Cymoxanil 8% + Mancozeb 64% WP @ 3 g/L or Dimethomorph 50% WP @ 1.5 g/L with sticker.\",\n      hi: \"साइमोक्सानिल + मेंकोजेब (3 ग्राम/लीटर) या डाइमेथोमॉर्फ का तुरंत सुरक्षात्मक छिड़काव करें।\",\n      as: \"চাইমক্সানিল আৰু মেনক'জেব মিহলাই স্প্ৰে কৰক।\",\n      es: \"Cimoxanilo + Mancozeb a 3 g/L o Dimetomorf 50% WP con humectante no iónico.\"\n    },\n    preventiveMeasures: {\n      en: \"Monitor weather warnings: 2 consecutive days with humidity >90% and temp 10-20°C trigger epidemics.\",\n      hi: \"मौसम चेतावनी देखें: 90% से अधिक आर्द्रता और 10-20°C तापमान में यह रोग तेजी से फैलता है।\",\n      as: \"বতৰৰ প্ৰতি লক্ষ্য ৰাখক; অত্যাধিক নিয়ৰ আৰু ঠাণ্ডাত এই ৰোগ সোনকালে বিয়পে।\",\n      es: \"Monitoreo agrometeorológico: humedad >90% con temperaturas de 10-20°C dispara la esporulación.\"\n    }\n  },\n  {\n    id: \"tomato-leaf-curl\",\n    cropId: \"tomato\",\n    cropName: { en: \"Tomato\", hi: \"टमाटर\", as: \"বিলাহী\", es: \"Tomate\" },\n    name: {\n      en: \"Tomato Leaf Curl Virus (ToLCV) & Whitefly\",\n      hi: \"पत्ता मरोड़ विषाणु (लीफ कर्ल) एवं सफेद मक्खी\",\n      as: \"বিলাহীৰ পাত কোঁচ খোৱা ভাইৰাছ আৰু বগা মাখি\",\n      es: \"Virus de la Cuchara del Tomate (TYLCV) y Mosca Blanca\"\n    },\n    part: \"leaf\",\n    symptoms: [\"leaf-curl\", \"yellowing\", \"stunted\"],\n    sampleImage: \"https://images.unsplash.com/photo-1592924357228-91a4daadcfea?auto=format&fit=crop&w=400&q=80\",\n    visualDescription: {\n      en: \"Severe upward or downward cupping/curling of leaves, thickened veins, and stunted bushy growth.\",\n      hi: \"पत्तियां ऊपर या नीचे की ओर मुड़कर नाव जैसी हो जाती हैं, नसें मोटी और पौधे की बढ़वार रुक जाती है।\",\n      as: \"পাতবোৰ ওপৰলৈ কোঁচ খাই নাওৰ নিচিনা হয় আৰু গছৰ বাঢ়ন বন্ধ হৈ জোপোহা হয়।\",\n      es: \"Hojas curvadas hacia arriba en forma de cuchara, engrosamiento de venas y enanismo severo.\"\n    },\n    severity: \"severe\",\n    organicRemedy: {\n      en: \"Install 15-20 yellow sticky traps per acre; spray 5% Neem Seed Kernel Extract (NSKE) every 7 days.\",\n      hi: \"प्रति एकड़ 15-20 पीले चिपचिपे कार्ड लगाएं; हर 7 दिन में 5% नीम अर्क का छिड़काव करें।\",\n      as: \"হালধীয়া আঠা লগোৱা ফলক ব্যৱহাৰ কৰক আৰু নিমৰ তেল ছটিয়াওক।\",\n      es: \"Trampas pegajosas amarillas (20/ha) y bioinsecticida a base de sales potásicas y aceite de neem.\"\n    },\n    chemicalTreatment: {\n      en: \"Imidacloprid 17.8% SL @ 0.5 ml/L or Diafenthiuron 50% WP @ 1.25 g/L to control vector whiteflies.\",\n      hi: \"सफेद मक्खी को नियंत्रित करने हेतु इमिडाक्लोप्रिड (0.5 मिली/लीटर) या डायफेन्थियूरॉन का छिड़काव करें।\",\n      as: \"বগা মাখি ধ্বংস কৰিবলৈ ইমিডাক্ল'প্ৰিড (০.৫ মিলিলিটাৰ/লিটাৰ) স্প্ৰে কৰক।\",\n      es: \"Control del vector: Imidacloprid 17.8% SL a 0.5 ml/L o Spiromesifen rotando modos de acción.\"\n    },\n    preventiveMeasures: {\n      en: \"Grow nursery seedlings under 40-mesh insect-proof nylon nets to prevent viral inoculation in early life.\",\n      hi: \"नर्सरी को 40-मेश वाली जालीदार जाली के नीचे उगाएं ताकि सफेद मक्खी छोटे पौधों को संक्रमित न कर सके।\",\n      as: \"পুলি প্ৰস্তুত কৰোঁতে মহৰীয়া কাপোৰৰ তলত ৰাখক যাতে মাখিয়ে ভাইৰাছ সুমুৱাব নোৱাৰে।\",\n      es: \"Vivero protegido bajo malla antitrip y antimosca de 40 a 50 hilos por pulgada.\"\n    }\n  },\n  {\n    id: \"mustard-aphids\",\n    cropId: \"mustard\",\n    cropName: { en: \"Mustard\", hi: \"सरसों\", as: \"সৰিয়হ\", es: \"Mostaza\" },\n    name: {\n      en: \"Mustard Aphid (Lipaphis erysimi)\",\n      hi: \"सरसों का माहू (चेपा कीट)\",\n      as: \"সৰিয়হৰ চেপা পোক\",\n      es: \"Pulgón de la Mostaza (Lipaphis erysimi)\"\n    },\n    part: \"stem\",\n    symptoms: [\"yellowing\", \"wilting\", \"stunted\"],\n    sampleImage: \"https://images.unsplash.com/photo-1508873696983-2df5293cb325?auto=format&fit=crop&w=400&q=80\",\n    visualDescription: {\n      en: \"Dense green-yellow colonies sucking sap on top shoots, flower buds, and young pods; sticky honeydew.\",\n      hi: \"फूलों, फलियों और टहनियों पर चिपके हुए छोटे हरे-पीले कीट जो रस चूसकर पौधे को सुखा देते हैं।\",\n      as: \"সৰিয়হৰ ফুল আৰু কুমলীয়া ছেঁইবোৰত সেউজীয়া-হালধীয়া পোকৰ জাক যিয়ে ৰস শুহি পেলায়।\",\n      es: \"Colonias densas verde-amarillentas succionando savia en brotes apicales y silicuas tiernas.\"\n    },\n    severity: \"moderate\",\n    organicRemedy: {\n      en: \"Spray Dashparni Ark or 2% soap solution + wood ash dust. Conserve natural Coccinellid ladybird predators.\",\n      hi: \"दशपर्णी अर्क या 2% साबुन के घोल का छिड़काव करें; लेडीबर्ड भृंग (मित्र कीट) का संरक्षण करें।\",\n      as: \"দহপৰ্ণী অৰ্ক বা চাবোন পানী স্প্ৰে কৰক; উপকাৰী বন্ধু পোকবোৰক ৰক্ষা কৰক।\",\n      es: \"Jabón potásico al 2% y conservación de mariquitas depredadoras naturales.\"\n    },\n    chemicalTreatment: {\n      en: \"Thiamethoxam 25% WG @ 0.3 g/L or Dimethoate 30% EC @ 1.5 ml/L in evening hours after bee activity ceases.\",\n      hi: \"थायमेथॉक्सम 25% WG (0.3 ग्राम/लीटर) का छिड़काव केवल शाम को करें जब मधुमक्खियां लौट जाएं।\",\n      as: \"সন্ধ্যাৰ ভাগত মৌ-মাখি আঁতৰি যোৱাৰ পিছত থায়মেথক্সাম ছটিয়াওক।\",\n      es: \"Tiametoxam 25% WG a 0.3 g/L al atardecer para no dañar las abejas polinizadoras.\"\n    },\n    preventiveMeasures: {\n      en: \"Complete sowing before October 25 to escape peak aphid flight population in January.\",\n      hi: \"25 अक्टूबर से पहले बुवाई पूरी कर लें ताकि जनवरी में माहू के peak से फसल बच सके।\",\n      as: \"২৫ অক্টোবৰৰ ভিতৰত বীজ সিঁচি শেষ কৰক যাতে পোকৰ আক্ৰমণৰ পৰা হাত সাৰিব পাৰি।\",\n      es: \"Siembra temprana antes de finales de octubre para escapar a la explosión poblacional invernal.\"\n    }\n  }\n];\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\data\\diseasesData.js"}}]}
