{"step_index":171,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T05:59:42Z","model":"gemini-3.8-flash-high","input_tokens":4318,"cache_read_tokens":88744,"output_tokens":2909,"thinking":"Developing the interactive UI components, the first step is building the navigation bar. This includes the AgriSense brand logo with a bilingual subtitle, and navigation links to key sections like the crop recommender and seasonal guide. A language selector dropdown will be implemented, featuring a globe icon and showing the active language flag with the native language name.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState } from 'react';\nimport { useLanguage } from '../context/LanguageContext';\nimport { \n  Sprout, \n  Globe, \n  PhoneCall, \n  Bot, \n  Menu, \n  X, \n  ChevronDown, \n  Calendar, \n  Stethoscope, \n  TrendingUp, \n  Compass \n} from 'lucide-react';\n\nexport default function Navbar({ onOpenAiAssistant }) {\n  const { currentLang, setCurrentLang, t, languages } = useLanguage();\n  const [langDropdownOpen, setLangDropdownOpen] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const currentLangObj = languages.find(l => l.code === currentLang) || languages[0];\n\n  const navLinks = [\n    { href: '#hero', label: t('nav.home'), icon: Compass },\n    { href: '#recommender', label: t('nav.crops'), icon: Sprout },\n    { href: '#calendar', label: t('nav.calendar'), icon: Calendar },\n    { href: '#doctor', label: t('nav.doctor'), icon: Stethoscope },\n    { href: '#mandi', label: t('nav.mandi'), icon: TrendingUp },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-forest-100 shadow-sm transition-all\">\n      {/* Top emergency & information banner */}\n      <div className=\"bg-forest-950 text-white text-xs py-1.5 px-4 sm:px-8 flex justify-between items-center font-medium\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n          <span className=\"hidden sm:inline text-forest-200\">{t('app.offlineReady')}</span>\n          <span className=\"sm:hidden text-forest-200\">AgriSense 2026</span>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-amber-400 font-semibold flex items-center gap-1.5\">\n            <PhoneCall className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden md:inline\">{t('app.kisanCallCenter')}:</span>\n            <a href=\"tel:18001801551\" className=\"underline hover:text-amber-300 tracking-wider\">\n              {t('app.helplineNumber')}\n            </a>\n          </span>\n        </div>\n      </div>\n\n      {/* Main navigation bar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-20\">\n          \n          {/* Logo & Brand Identity */}\n          <a href=\"#hero\" className=\"flex items-center gap-3 group\">\n            <div className=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-forest-800 to-forest-900 flex items-center justify-center text-amber-400 shadow-md group-hover:scale-105 transition-transform\">\n              <Sprout className=\"w-7 h-7\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"text-2xl font-black tracking-tight text-forest-950\">AgriSense</span>\n                <span className=\"text-xs font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300\">\n                  AI\n                </span>\n              </div>\n              <p className=\"text-xs text-forest-700 font-medium tracking-wide\">\n                KrishiMitra • कृषि मित्र\n              </p>\n            </div>\n          </a>\n\n          {/* Desktop Navigation Links */}\n          <nav className=\"hidden lg:flex items-center space-x-1\">\n            {navLinks.map((link) => {\n              const Icon = link.icon;\n              return (\n                <a\n                  key={link.href}\n                  href={link.href}\n                  className=\"flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold text-gray-700 hover:text-forest-900 hover:bg-forest-50 transition-colors\"\n                >\n                  <Icon className=\"w-4 h-4 text-forest-600\" />\n                  <span>{link.label}</span>\n                </a>\n              );\n            })}\n          </nav>\n\n          {/* Right actions: Language switcher + AI CTA */}\n          <div className=\"hidden sm:flex items-center gap-3\">\n            {/* Language Selector Dropdown */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setLangDropdownOpen(!langDropdownOpen)}\n                className=\"flex items-center gap-2 px-3.5 py-2.5 rounded-xl border border-gray-200 bg-white hover:bg-forest-50 hover:border-forest-300 text-sm font-semibold text-gray-800 transition-all shadow-sm focus:ring-2 focus:ring-forest-600 min-h-[46px]\"\n                aria-label=\"Select Language\"\n              >\n                <Globe className=\"w-4 h-4 text-forest-700\" />\n                <span className=\"text-base\">{currentLangObj.flag}</span>\n                <span className=\"font-bold text-forest-950\">{currentLangObj.native}</span>\n                <ChevronDown className=\"w-4 h-4 text-gray-500\" />\n              </button>\n\n              {langDropdownOpen && (\n                <div className=\"absolute right-0 mt-2 w-48 rounded-xl bg-white border border-gray-200 shadow-elevated py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150\">\n                  <div className=\"px-3 py-1.5 text-xs font-semibold text-gray-400 uppercase tracking-wider border-b border-gray-100\">\n                    {t('nav.language')}\n                  </div>\n                  {languages.map((lang) => (\n                    <button\n                      key={lang.code}\n                      onClick={() => {\n                        setCurrentLang(lang.code);\n                        setLangDropdownOpen(false);\n                      }}\n                      className={`w-full flex items-center justify-between px-3.5 py-2.5 text-sm text-left font-medium transition-colors ${\n                        currentLang === lang.code \n                          ? 'bg-forest-100 text-forest-900 font-bold' \n                          : 'text-gray-700 hover:bg-forest-50'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5\">\n                        <span className=\"text-lg\">{lang.flag}</span>\n                        <span>{lang.native}</span>\n                      </div>\n                      <span className=\"text-xs uppercase font-mono text-gray-400\">\n                        {lang.code}\n                      </span>\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* High-Contrast \"Ask AI Agronomist\" CTA Button (Min 48px height) */}\n            <button\n              onClick={onOpenAiAssistant}\n              className=\"flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white font-bold text-sm shadow-md hover:shadow-lg active:scale-95 transition-all min-h-[48px]\"\n            >\n              <Bot className=\"w-5 h-5 text-amber-200\" />\n              <span>{t('nav.askAi')}</span>\n            </button>\n          </div>\n\n          {/* Mobile hamburger menu toggle */}\n          <div className=\"flex sm:hidden items-center gap-2\">\n            <button\n              onClick={onOpenAiAssistant}\n              className=\"p-2.5 rounded-xl bg-amber-600 text-white shadow-sm\"\n              aria-label=\"Ask AI\"\n            >\n              <Bot className=\"w-5 h-5\" />\n            </button>\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2.5 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-100 min-h-[44px]\"\n              aria-label=\"Open Menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"sm:hidden border-t border-forest-100 bg-white px-4 pt-3 pb-6 space-y-4 shadow-xl animate-in slide-in-from-top duration-200\">\n          <div className=\"space-y-1\">\n            {navLinks.map((link) => {\n              const Icon = link.icon;\n              return (\n                <a\n                  key={link.href}\n                  href={link.href}\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"flex items-center gap-3 px-3 py-3 rounded-xl text-base font-semibold text-gray-800 hover:bg-forest-50 hover:text-forest-900\"\n                >\n                  <Icon className=\"w-5 h-5 text-forest-700\" />\n                  <span>{link.label}</span>\n                </a>\n              );\n            })}\n          </div>\n\n          <div className=\"pt-3 border-t border-gray-100\">\n            <p className=\"text-xs font-semibold uppercase text-gray-500 mb-2\">\n              {t('nav.language')}\n            </p>\n            <div className=\"grid grid-cols-2 gap-2\">\n              {languages.map((lang) => (\n                <button\n                  key={lang.code}\n                  onClick={() => {\n                    setCurrentLang(lang.code);\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border text-sm font-semibold transition-all ${\n                    currentLang === lang.code\n                      ? 'border-forest-600 bg-forest-50 text-forest-900'\n                      : 'border-gray-200 text-gray-700 hover:bg-gray-50'\n                  }`}\n                >\n                  <span>{lang.flag}</span>\n                  <span>{lang.native}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\Navbar.jsx"}}]}
