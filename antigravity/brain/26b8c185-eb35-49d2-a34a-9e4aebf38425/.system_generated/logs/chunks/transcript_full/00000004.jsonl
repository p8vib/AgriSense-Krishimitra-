}\n          <div className=\"md:col-span-3 space-y-3\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n              {t('footer.quickLinks')}\n            </h4>\n            <ul className=\"space-y-2 text-xs font-medium text-forest-200\">\n              <li><a href=\"#hero\" className=\"hover:text-white transition-colors\">{t('nav.home')}</a></li>\n              <li><a href=\"#recommender\" className=\"hover:text-white transition-colors\">{t('nav.crops')}</a></li>\n              <li><a href=\"#calendar\" className=\"hover:text-white transition-colors\">{t('nav.calendar')}</a></li>\n              <li><a href=\"#doctor\" className=\"hover:text-white transition-colors\">{t('nav.doctor')}</a></li>\n              <li><a href=\"#mandi\" className=\"hover:text-white transition-colors\">{t('nav.mandi')}</a></li>\n              <li>\n                <button \n                  onClick={onOpenAiAssistant} \n                  className=\"hover:text-amber-300 text-amber-400 font-semibold transition-colors flex items-center gap-1\"\n                >\n                  {t('nav.askAi')} →\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Emergency & Advisory Helpline Card */}\n          <div className=\"md:col-span-4 space-y-3\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n              {t('footer.helplineHeader')}\n            </h4>\n            \n            <div className=\"p-4 rounded-2xl bg-forest-900 border border-forest-700/80 space-y-2\">\n              <div className=\"flex items-center gap-2 text-amber-400 font-bold text-sm\">\n                <PhoneCall className=\"w-4 h-4\" />\n                <span>{t('app.kisanCallCenter')}</span>\n              </div>\n              <p className=\"text-xl font-black tracking-wider text-white\">\n                <a href=\"tel:18001801551\" className=\"hover:underline\">\n                  1800-180-1551\n                </a>\n              </p>\n              <p className=\"text-[11px] text-forest-300 leading-normal\">\n                Toll-free advisory support in 22 regional Indian languages from 6:00 AM to 10:00 PM every day.\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom Credits & Legal */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-forest-400\">\n          <p>{t('footer.copyright')}</p>\n          <p className=\"text-center sm:text-right text-[11px]\">\n            {t('footer.legal')}\n          </p>\n        </div>\n\n      </div>\n    </footer>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\Footer.jsx"}}]}
