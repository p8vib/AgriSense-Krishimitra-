\n                  </span>\n                </div>\n\n                {!isAi && (\n                  <div className=\"w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 mt-0.5\">\n                    <User className=\"w-4 h-4\" />\n                  </div>\n                )}\n              </div>\n            );\n          })}\n\n          {/* Listening indicator */}\n          {isListening && (\n            <div className=\"flex items-center gap-2 p-3 rounded-xl bg-amber-100 text-amber-900 text-xs font-bold animate-pulse\">\n              <Mic className=\"w-4 h-4 text-amber-700\" />\n              <span>{t('ai.listening')}</span>\n            </div>\n          )}\n\n          <div ref={messagesEndRef} />\n        </div>\n\n        {/* Input Bar */}\n        <div className=\"p-4 bg-white border-t border-gray-100 space-y-2\">\n          <form\n            onSubmit={(e) => {\n              e.preventDefault();\n              handleSendMessage();\n            }}\n            className=\"flex items-center gap-2\"\n          >\n            <input\n              type=\"text\"\n              value={inputQuery}\n              onChange={(e) => setInputQuery(e.target.value)}\n              placeholder={t('ai.placeholder')}\n              className=\"flex-1 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-forest-600 focus:bg-white\"\n            />\n\n            {/* Voice Input Button */}\n            <button\n              type=\"button\"\n              onClick={handleSimulateVoice}\n              className={`p-3 rounded-xl border transition-all ${\n                isListening\n                  ? 'bg-rose-500 text-white border-rose-600 animate-bounce'\n                  : 'bg-gray-100 hover:bg-forest-100 text-gray-700 hover:text-forest-900 border-gray-200'\n              }`}\n              title={t('ai.voiceBtn')}\n              aria-label={t('ai.voiceBtn')}\n            >\n              <Mic className=\"w-4 h-4\" />\n            </button>\n\n            {/* Send Button */}\n            <button\n              type=\"submit\"\n              className=\"p-3 rounded-xl bg-forest-900 hover:bg-forest-800 text-white shadow-sm transition-transform active:scale-95\"\n              aria-label=\"Send Message\"\n            >\n              <Send className=\"w-4 h-4 text-amber-400\" />\n            </button>\n          </form>\n\n          <p className=\"text-[10px] text-gray-400 text-center font-medium leading-tight\">\n            {t('ai.disclaimer')}\n          </p>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\AiAssistantDrawer.jsx"}}]}
