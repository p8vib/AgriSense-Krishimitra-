{"step_index":185,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T06:04:16Z","model":"gemini-3.8-flash-high","input_tokens":5214,"cache_read_tokens":119690,"output_tokens":3567,"thinking":"I'm thinking through how to approach this.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState } from 'react';\nimport { useLanguage } from '../context/LanguageContext';\nimport { mandiRatesData, governmentSchemesData } from '../data/mandiAndSchemesData';\nimport { \n  TrendingUp, \n  TrendingDown, \n  Search, \n  Award, \n  FileText, \n  CheckCircle, \n  ExternalLink, \n  X, \n  HelpCircle,\n  Building,\n  Sparkles\n} from 'lucide-react';\n\nexport default function MandiAndSchemes() {\n  const { currentLang, t } = useLanguage();\n  const [searchTerm, setSearchTerm] = useState('');\n  const [selectedScheme, setSelectedScheme] = useState(null);\n\n  // Filter Mandi rates\n  const filteredMandi = mandiRatesData.filter(item => {\n    const commName = (item.commodity[currentLang] || item.commodity.en).toLowerCase();\n    const marketName = (item.market[currentLang] || item.market.en).toLowerCase();\n    const search = searchTerm.toLowerCase();\n    return commName.includes(search) || marketName.includes(search);\n  });\n\n  return (\n    <section id=\"mandi\" className=\"py-16 sm:py-20 bg-white border-t border-forest-100\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16\">\n        \n        {/* Top Section: Live Mandi Commodity Rates */}\n        <div>\n          <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8\">\n            <div>\n              <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-forest-100 text-forest-900 text-xs font-bold uppercase tracking-wider mb-3\">\n                <TrendingUp className=\"w-4 h-4 text-forest-700\" />\n                <span>Market Intelligence</span>\n              </div>\n              <h2 className=\"text-3xl sm:text-4xl font-black text-forest-950 tracking-tight\">\n                {t('mandi.title')}\n              </h2>\n              <p className=\"mt-2 text-base text-gray-600 font-medium max-w-2xl\">\n                {t('mandi.subtitle')}\n              </p>\n            </div>\n\n            {/* Search filter bar */}\n            <div className=\"relative w-full md:w-80\">\n              <Search className=\"w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                value={searchTerm}\n                onChange={(e) => setSearchTerm(e.target.value)}\n                placeholder={t('mandi.searchPlaceholder')}\n                className=\"w-full bg-gray-50 border border-gray-200 rounded-xl pl-10 pr-4 py-2.5 text-xs font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-forest-600 focus:bg-white transition-all\"\n              />\n            </div>\n          </div>\n\n          {/* Mandi Rates Table */}\n          <div className=\"overflow-x-auto rounded-3xl border border-forest-100 shadow-card bg-white\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-forest-950 text-white text-xs font-bold uppercase tracking-wider\">\n                  <th className=\"py-4 px-6\">{t('mandi.commodity')}</th>\n                  <th className=\"py-4 px-4\">{t('mandi.market')}</th>\n                  <th className=\"py-4 px-4\">{t('mandi.msp')}</th>\n                  <th className=\"py-4 px-4\">{t('mandi.currentPrice')}</th>\n                  <th className=\"py-4 px-4\">{t('mandi.trend')}</th>\n                  <th className=\"py-4 px-6\">{t('mandi.arrivals')}</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-gray-100 text-xs font-medium text-gray-700\">\n                {filteredMandi.map((row) => {\n                  const commName = row.commodity[currentLang] || row.commodity.en;\n                  const marketName = row.market[currentLang] || row.market.en;\n\n                  return (\n                    <tr key={row.id} className=\"hover:bg-forest-50/40 transition-colors\">\n                      <td className=\"py-4 px-6\">\n                        <span className=\"font-bold text-gray-950 block text-sm\">{commName}</span>\n                        <span className=\"text-gray-400 text-[11px] font-mono\">{row.variety}</span>\n                      </td>\n\n                      <td className=\"py-4 px-4 text-gray-800 font-semibold\">\n                        {marketName}\n                      </td>\n\n                      <td className=\"py-4 px-4 font-mono font-bold text-gray-600\">\n                        ₹{row.msp.toLocaleString()}\n                      </td>\n\n                      <td className=\"py-4 px-4 font-mono font-black text-forest-950 text-sm\">\n                        ₹{row.currentPrice.toLocaleString()}\n                      </td>\n\n                      <td className=\"py-4 px-4\">\n                        <span className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold ${\n                          row.trendUp\n                            ? 'bg-emerald-100 text-emerald-800'\n                            : 'bg-rose-100 text-rose-800'\n                        }`}>\n                          {row.trendUp ? (\n                            <TrendingUp className=\"w-3 h-3 text-emerald-600\" />\n                          ) : (\n                            <TrendingDown className=\"w-3 h-3 text-rose-600\" />\n                          )}\n                          {row.change}\n                        </span>\n                      </td>\n\n                      <td className=\"py-4 px-6 text-gray-500 font-mono\">\n                        {row.arrivals}\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        {/* Bottom Section: Government Schemes & Subsidies */}\n        <div className=\"pt-6\">\n          <div className=\"max-w-3xl mb-8\">\n            <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider mb-3\">\n              <Award className=\"w-4 h-4 text-amber-600\" />\n              <span>Welfare & Grants</span>\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl font-black text-forest-950 tracking-tight\">\n              {t('mandi.schemesTitle')}\n            </h2>\n            <p className=\"mt-2 text-base text-gray-600 font-medium\">\n              {t('mandi.schemesSubtitle')}\n            </p>\n          </div>\n\n          {/* Scheme Cards Grid */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {governmentSchemesData.map((scheme) => {\n              const name = scheme.name[currentLang] || scheme.name.en;\n              const badge = scheme.badge[currentLang] || scheme.badge.en;\n              const benefit = scheme.benefit[currentLang] || scheme.benefit.en;\n              const eligibility = scheme.eligibility[currentLang] || scheme.eligibility.en;\n\n              return (\n                <div\n                  key={scheme.id}\n                  className=\"bg-cream-50/70 p-6 sm:p-7 rounded-3xl border border-forest-100 shadow-card hover:shadow-elevated transition-all flex flex-col justify-between space-y-4\"\n                >\n                  <div className=\"space-y-3\">\n                    <div className=\"flex items-center justify-between gap-2\">\n                      <span className=\"px-3 py-1 rounded-full bg-forest-900 text-white text-xs font-bold\">\n                        {badge}\n                      </span>\n                      <Building className=\"w-5 h-5 text-forest-600\" />\n                    </div>\n\n                    <h3 className=\"text-xl font-bold text-forest-950\">\n                      {name}\n                    </h3>\n\n                    <div className=\"space-y-2 pt-2 border-t border-forest-200/60 text-xs\">\n                      <div>\n                        <span className=\"font-bold text-gray-800 block text-[11px] uppercase tracking-wider text-forest-800\">\n                          {t('mandi.benefit')}:\n                        </span>\n                        <p className=\"text-gray-700 font-medium mt-0.5 leading-relaxed\">\n                          {benefit}\n                        </p>\n                      </div>\n\n                      <div>\n                        <span className=\"font-bold text-gray-800 block text-[11px] uppercase tracking-wider text-forest-800\">\n                          {t('mandi.eligibility')}:\n                        </span>\n                        <p className=\"text-gray-600 font-medium mt-0.5 leading-relaxed\">\n                          {eligibility}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => setSelectedScheme(scheme)}\n                    className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-forest-900 hover:bg-forest-800 text-white font-bold text-xs shadow transition-all min-h-[46px] active:scale-[0.98]\"\n                  >\n                    <span>{t('mandi.learnMore')}</span>\n                    <ExternalLink className=\"w-4 h-4 text-amber-400\" />\n                  </button>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n      </div>\n\n      {/* Scheme Detail Application Modal */}\n      {selectedScheme && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-sm overflow-y-auto animate-in fade-in duration-200\">\n          <div \n            className=\"bg-white rounded-3xl max-w-2xl w-full shadow-2xl border border-forest-100 overflow-hidden my-8 p-6 sm:p-8 space-y-6 relative\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <button\n              onClick={() => setSelectedScheme(null)}\n              className=\"absolute top-5 right-5 w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-600 transition-colors\"\n              aria-label=\"Close\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div>\n              <span className=\"px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider\">\n                {t('mandi.applyModalTitle')}\n              </span>\n              <h3 className=\"text-2xl font-black text-forest-950 mt-2\">\n                {selectedScheme.name[currentLang] || selectedScheme.name.en}\n              </h3>\n            </div>\n\n            {/* Application Steps */}\n            <div className=\"p-4 rounded-2xl bg-forest-50 border border-forest-200 text-xs space-y-1.5\">\n              <span className=\"font-bold text-forest-900 uppercase tracking-wider block\">\n                {t('mandi.howToApply')}:\n              </span>\n              <p className=\"text-gray-800 leading-relaxed font-medium\">\n                {selectedScheme.applySteps[currentLang] || selectedScheme.applySteps.en}\n              </p>\n            </div>\n\n            {/* Required Documents Checklist */}\n            <div>\n              <span className=\"font-bold text-xs text-gray-900 uppercase tracking-wider block mb-2\">\n                {t('mandi.requiredDocs')}:\n              </span>\n              <ul className=\"space-y-1.5 text-xs text-gray-700\">\n                {selectedScheme.documents.map((doc, idx) => (\n                  <li key={idx} className=\"flex items-center gap-2\">\n                    <CheckCircle className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                    <span>{doc}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Official Portal Link */}\n            <div className=\"pt-4 border-t border-gray-100 flex items-center justify-between\">\n              <a\n                href={selectedScheme.officialLink}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-forest-900 hover:bg-forest-800 text-white font-bold text-xs shadow transition-all\"\n              >\n                <span>Visit Official Portal</span>\n                <ExternalLink className=\"w-3.5 h-3.5 text-amber-300\" />\n              </a>\n\n              <button\n                onClick={() => setSelectedScheme(null)}\n                className=\"px-4 py-2 text-xs font-bold text-gray-500 hover:text-gray-800\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\MandiAndSchemes.jsx"}}]}
