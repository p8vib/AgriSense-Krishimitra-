l Languages</span>\n              </div>\n              <div className=\"bg-white/80 p-3 rounded-xl border border-forest-100\">\n                <span className=\"block text-xl sm:text-2xl font-black text-forest-900\">100%</span>\n                <span className=\"text-xs text-gray-600 font-medium\">Free & Offline Ready</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Quick Local Weather & Soil Snapshot Widget */}\n          <div className=\"lg:col-span-5\">\n            <div className=\"bg-white rounded-3xl p-6 sm:p-7 border border-forest-100 shadow-elevated relative overflow-hidden\">\n              \n              {/* Card Header with Location Switcher */}\n              <div className=\"flex items-center justify-between gap-2 pb-5 border-b border-gray-100\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-10 h-10 rounded-xl bg-forest-100 flex items-center justify-center text-forest-800\">\n                    <CloudSun className=\"w-6 h-6\" />\n                  </div>\n                  <div>\n                    <h2 className=\"text-sm font-bold text-gray-900\">{t('hero.weatherTitle')}</h2>\n                    <p className=\"text-xs text-forest-700 font-medium\">{t('hero.forecastSubtitle')}</p>\n                  </div>\n                </div>\n\n                {/* Location Selector Dropdown */}\n                <div className=\"flex items-center gap-1.5 bg-forest-50 px-3 py-1.5 rounded-lg border border-forest-200\">\n                  <MapPin className=\"w-4 h-4 text-forest-700 shrink-0\" />\n                  <select\n                    value={selectedLocationKey}\n                    onChange={handleLocationChange}\n                    className=\"bg-transparent text-xs font-bold text-forest-950 focus:outline-none cursor-pointer\"\n                    aria-label={t('hero.changeLocation')}\n                  >\n                    {Object.values(regionalWeatherPresets).map((loc) => (\n                      <option key={loc.id} value={loc.id}>\n                        {loc.name[currentLang] || loc.name.en}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n              </div>\n\n              {/* Real-time Metric Grid */}\n              <div className=\"grid grid-cols-2 gap-3.5 my-5\">\n                \n                {/* Temperature */}\n                <div className=\"p-3.5 rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50/50 border border-amber-200/60\">\n                  <div className=\"flex items-center gap-2 text-amber-800 mb-1\">\n                    <Thermometer className=\"w-4 h-4 text-amber-600\" />\n                    <span className=\"text-xs font-semibold\">{t('hero.temperature')}</span>\n                  </div>\n                  <div className=\"flex items-baseline gap-1\">\n                    <span className=\"text-2xl sm:text-3xl font-black text-gray-900\">{weather.temp}°</span>\n                    <span className=\"text-sm font-semibold text-gray-600\">C</span>\n                  </div>\n                  <span className=\"text-[11px] font-medium text-amber-700 block mt-0.5\">\n                    {weather.rainfallStatus[currentLang] || weather.rainfallStatus.en}\n                  </span>\n                </div>\n\n                {/* Soil Moisture */}\n                <div className=\"p-3.5 rounded-2xl bg-gradient-to-br from-forest-50 to-emerald-50/50 border border-forest-200/60\">\n                  <div className=\"flex items-center gap-2 text-forest-800 mb-1\">\n                    <Waves className=\"w-4 h-4 text-forest-600\" />\n                    <span className=\"text-xs font-semibold\">{t('hero.soilMoisture')}</span>\n                  </div>\n                  <div className=\"flex items-baseline gap-1\">\n                    <span className=\"text-2xl sm:text-3xl font-black text-forest-950\">{weather.soilMoisture}%</span>\n                  </div>\n                  <div className=\"flex items-center gap-1 mt-0.5\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span className=\"text-[11px] font-semibold text-emerald-700\">\n                      {t('hero.soilHealthGood')}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Humidity */}\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/70\">\n                  <div className=\"flex items-center gap-2 text-gray-700 mb-1\">\n                    <Droplets className=\"w-4 h-4 text-blue-500\" />\n                    <span className=\"text-xs font-semibold\">{t('hero.humidity')}</span>\n                  </div>\n                  <span className=\"text-xl sm:text-2xl font-black text-gray-900\">{weather.humidity}%</span>\n                </div>\n\n                {/* Rainfall */}\n                <div className=\"p-3.5 rounded-2xl bg-gray-50 border border-gray-200/70\">\n                  <div className=\"flex items-center gap-2 text-gray-700 mb-1\">\n                    <CloudSun className=\"w-4 h-4 text-sky-600\" />\n                    <span className=\"text-xs font-semibold\">{t('hero.rainfall')}</span>\n                  </div>\n                  <div className=\"flex items-baseline gap-1\">\n                    <span className=\"text-xl sm:text-2xl font-black text-gray-900\">{weather.rainfall}</span>\n                    <span className=\"text-xs font-semibold text-gray-600\">{t('hero.rainUnit')}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* 7-Day Trend Visualization with Recharts */}\n              <div className=\"pt-2 border-t border-gray-100\">\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-bold text-gray-700 flex items-center gap-1.5\">\n                    <TrendingUp className=\"w-3.5 h-3.5 text-forest-700\" />\n                    {t('hero.trendTitle')}\n                  </span>\n                  <div className=\"flex items-center gap-3 text-[10px] font-semibold text-gray-500\">\n                    <span className=\"flex items-center gap-1\">\n                      <span className=\"w-2 h-2 rounded-full bg-amber-500\"></span> Temp (°C)\n                    </span>\n                    <span className=\"flex items-center gap-1\">\n                      <span className=\"w-2 h-2 rounded-full bg-forest-600\"></span> Soil (%)\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"h-28 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <AreaChart data={weather.forecast} margin={{ top: 5, right: 5, left: -25, bottom: 0 }}>\n                      <defs>\n                        <linearGradient id=\"tempGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#d97706\" stopOpacity={0.4}/>\n                          <stop offset=\"95%\" stopColor=\"#d97706\" stopOpacity={0.0}/>\n                        </linearGradient>\n                        <linearGradient id=\"soilGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#2d6a4f\" stopOpacity={0.3}/>\n                          <stop offset=\"95%\" stopColor=\"#2d6a4f\" stopOpacity={0.0}/>\n                        </linearGradient>\n                      </defs>\n                      <XAxis dataKey=\"day\" tick={{ fontSize: 10, fill: '#6B7280' }} tickLine={false} />\n                      <YAxis tick={{ fontSize: 9, fill: '#9CA3AF' }} domain={[15, 85]} tickLine={false} />\n                      <Tooltip \n                        contentStyle={{ \n                          backgroundColor: '#1b4332', \n                          borderRadius: '8px', \n                          border: 'none', \n                          color: '#fff', \n                          fontSize: '11px',\n                          padding: '6px 10px'\n                        }} \n                      />\n                      <Area type=\"monotone\" dataKey=\"temp\" stroke=\"#d97706\" strokeWidth={2} fillOpacity={1} fill=\"url(#tempGradient)\" name=\"Temp (°C)\" />\n                      <Area type=\"monotone\" dataKey=\"soil\" stroke=\"#2d6a4f\" strokeWidth={2} fillOpacity={1} fill=\"url(#soilGradient)\" name=\"Soil (%)\" />\n                    </AreaChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\Hero.jsx"}}]}
