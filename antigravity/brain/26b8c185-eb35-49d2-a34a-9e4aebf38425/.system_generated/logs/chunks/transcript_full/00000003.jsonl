{"step_index":181,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T06:02:39Z","model":"gemini-3.8-flash-high","input_tokens":5673,"cache_read_tokens":109671,"output_tokens":4239,"thinking":"Initial focus is on constructing the CropDoctor component, starting with an interactive symptom checker. The symptom checker will guide the user through a selection process: crop, plant part, and observed symptoms. This will be followed by a diagnostic output card to display the likely disease.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState } from 'react';\nimport { useLanguage } from '../context/LanguageContext';\nimport { diseasesDatabase } from '../data/diseasesData';\nimport { \n  Stethoscope, \n  AlertTriangle, \n  CheckCircle2, \n  RotateCcw, \n  Leaf, \n  ShieldCheck, \n  FlaskConical, \n  Upload, \n  Sparkles,\n  Camera,\n  Info\n} from 'lucide-react';\n\nexport default function CropDoctor() {\n  const { currentLang, t } = useLanguage();\n\n  const [selectedCrop, setSelectedCrop] = useState('tomato');\n  const [selectedPart, setSelectedPart] = useState('leaf');\n  const [selectedSymptoms, setSelectedSymptoms] = useState(['brown-spots', 'yellowing']);\n  const [activeDiagnosis, setActiveDiagnosis] = useState(diseasesDatabase[0]);\n  const [uploadedPreview, setUploadedPreview] = useState(null);\n\n  const symptomList = [\n    { id: 'yellowing', label: 'Yellowing / Chlorosis' },\n    { id: 'brown-spots', label: 'Brown / Black Spots' },\n    { id: 'wilting', label: 'Wilting / Drooping' },\n    { id: 'leaf-curl', label: 'Leaf Curling / Cupping' },\n    { id: 'stunted', label: 'Stunted Bushy Growth' },\n  ];\n\n  const handleToggleSymptom = (symptomId) => {\n    setSelectedSymptoms(prev => \n      prev.includes(symptomId)\n        ? prev.filter(s => s !== symptomId)\n        : [...prev, symptomId]\n    );\n  };\n\n  const handleDiagnose = () => {\n    // Find closest match in diseasesDatabase\n    const matched = diseasesDatabase.find(d => \n      d.cropId === selectedCrop && \n      (d.part === selectedPart || d.symptoms.some(s => selectedSymptoms.includes(s)))\n    ) || diseasesDatabase.find(d => d.cropId === selectedCrop) || diseasesDatabase[0];\n\n    setActiveDiagnosis(matched);\n  };\n\n  const handleSelectSample = (disease) => {\n    setSelectedCrop(disease.cropId);\n    setSelectedPart(disease.part);\n    setSelectedSymptoms(disease.symptoms);\n    setActiveDiagnosis(disease);\n    setUploadedPreview(disease.sampleImage);\n  };\n\n  const handleSimulatedUpload = (e) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const url = URL.createObjectURL(file);\n      setUploadedPreview(url);\n      // Auto-match for user convenience\n      handleDiagnose();\n    }\n  };\n\n  const handleReset = () => {\n    setSelectedCrop('tomato');\n    setSelectedPart('leaf');\n    setSelectedSymptoms(['brown-spots']);\n    setActiveDiagnosis(null);\n    setUploadedPreview(null);\n  };\n\n  return (\n    <section id=\"doctor\" className=\"py-16 sm:py-20 bg-cream-50/70 border-t border-forest-100\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Section Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-12\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-forest-100 text-forest-900 text-xs font-bold uppercase tracking-wider mb-3\">\n            <Stethoscope className=\"w-4 h-4 text-forest-700\" />\n            <span>Pathology Diagnostic AI</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-black text-forest-950 tracking-tight\">\n            {t('doctor.title')}\n          </h2>\n          <p className=\"mt-3 text-base text-gray-600 font-medium\">\n            {t('doctor.subtitle')}\n          </p>\n        </div>\n\n        {/* Diagnostic Workspace Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Symptom Checker Controls */}\n          <div className=\"lg:col-span-5 bg-white p-6 sm:p-7 rounded-3xl border border-forest-100 shadow-card space-y-6\">\n            \n            <div className=\"flex items-center justify-between pb-3 border-b border-gray-100\">\n              <span className=\"font-bold text-gray-900 text-sm flex items-center gap-2\">\n                <Leaf className=\"w-4 h-4 text-forest-700\" />\n                <span>Field Symptom Checklist</span>\n              </span>\n              <button\n                onClick={handleReset}\n                className=\"flex items-center gap-1 text-xs font-bold text-gray-500 hover:text-amber-700 transition-colors\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>{t('doctor.resetBtn')}</span>\n              </button>\n            </div>\n\n            {/* 1. Select Crop */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5\">\n                {t('doctor.selectCrop')}\n              </label>\n              <div className=\"grid grid-cols-3 gap-2\">\n                {[\n                  { id: 'tomato', label: 'Tomato / आलू/टमाटर' },\n                  { id: 'paddy', label: 'Rice / धान' },\n                  { id: 'wheat', label: 'Wheat / गेहूं' },\n                  { id: 'potato', label: 'Potato / आलू' },\n                  { id: 'mustard', label: 'Mustard / सरसों' },\n                ].map(c => (\n                  <button\n                    key={c.id}\n                    onClick={() => setSelectedCrop(c.id)}\n                    className={`px-3 py-2.5 rounded-xl text-xs font-bold transition-all border ${\n                      selectedCrop === c.id\n                        ? 'bg-forest-900 text-white border-forest-900 shadow-sm'\n                        : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-forest-50'\n                    }`}\n                  >\n                    {c.label.split(' / ')[0]}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* 2. Plant Part */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5\">\n                {t('doctor.affectedPart')}\n              </label>\n              <div className=\"grid grid-cols-3 gap-2\">\n                {[\n                  { id: 'leaf', label: t('doctor.leaf') },\n                  { id: 'stem', label: t('doctor.stem') },\n                  { id: 'fruit', label: t('doctor.fruit') },\n                ].map(p => (\n                  <button\n                    key={p.id}\n                    onClick={() => setSelectedPart(p.id)}\n                    className={`px-3 py-2 rounded-xl text-xs font-bold transition-all border ${\n                      selectedPart === p.id\n                        ? 'bg-amber-600 text-white border-amber-600 shadow-sm'\n                        : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100'\n                    }`}\n                  >\n                    {p.label.split(' ')[0]}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* 3. Symptoms Multi-select */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2\">\n                {t('doctor.checkSymptoms')}\n              </label>\n              <div className=\"space-y-2\">\n                {symptomList.map(sym => {\n                  const isChecked = selectedSymptoms.includes(sym.id);\n                  return (\n                    <button\n                      key={sym.id}\n                      onClick={() => handleToggleSymptom(sym.id)}\n                      className={`w-full flex items-center justify-between p-3 rounded-xl border text-xs font-bold transition-all ${\n                        isChecked \n                          ? 'border-forest-600 bg-forest-50/80 text-forest-950' \n                          : 'border-gray-200 bg-white text-gray-600 hover:bg-gray-50'\n                      }`}\n                    >\n                      <span>{sym.label}</span>\n                      <span className={`w-5 h-5 rounded-lg flex items-center justify-center text-xs ${\n                        isChecked ? 'bg-forest-700 text-white' : 'border border-gray-300'\n                      }`}>\n                        {isChecked && '✓'}\n                      </span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* Visual Leaf Sample Quick-Picks */}\n            <div>\n              <span className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2\">\n                {t('doctor.orUpload')}\n              </span>\n              <div className=\"grid grid-cols-3 gap-2\">\n                {diseasesDatabase.slice(0, 3).map((d) => (\n                  <button\n                    key={d.id}\n                    onClick={() => handleSelectSample(d)}\n                    className=\"group relative rounded-xl overflow-hidden border border-gray-200 hover:border-forest-600 aspect-square transition-all\"\n                  >\n                    <img \n                      src={d.sampleImage} \n                      alt={d.name.en} \n                      className=\"w-full h-full object-cover group-hover:scale-105 transition-transform\" \n                    />\n                    <div className=\"absolute inset-0 bg-black/40 flex items-end p-1.5 text-[10px] font-bold text-white leading-tight\">\n                      {d.cropName[currentLang] || d.cropName.en}\n                    </div>\n                  </button>\n                ))}\n              </div>\n\n              {/* Simulated Camera / File Upload Button */}\n              <label className=\"mt-3 flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl border-2 border-dashed border-gray-300 hover:border-forest-600 text-gray-600 hover:text-forest-900 cursor-pointer text-xs font-bold transition-colors\">\n                <Camera className=\"w-4 h-4 text-forest-700\" />\n                <span>Upload Leaf Photo / Camera</span>\n                <input\n                  type=\"file\"\n                  accept=\"image/*\"\n                  onChange={handleSimulatedUpload}\n                  className=\"hidden\"\n                />\n              </label>\n            </div>\n\n            {/* Analyze CTA button (min 48px height) */}\n            <button\n              onClick={handleDiagnose}\n              className=\"w-full py-3.5 px-6 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all min-h-[48px] active:scale-[0.98]\"\n            >\n              {t('doctor.diagnoseBtn')}\n            </button>\n\n          </div>\n\n          {/* Right Column: Diagnostic Report Card */}\n          <div className=\"lg:col-span-7\">\n            {activeDiagnosis ? (\n              <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-forest-100 shadow-card space-y-6\">\n                \n                {/* Report Header */}\n                <div className=\"pb-5 border-b border-gray-100\">\n                  <div className=\"flex flex-wrap items-center justify-between gap-3 mb-2\">\n                    <span className=\"px-3 py-1 rounded-full bg-forest-100 text-forest-900 text-xs font-bold\">\n                      {t('doctor.diagnosisResult')}\n                    </span>\n\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center gap-1\">\n                        <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                        94% {t('doctor.confidence')}\n                      </span>\n\n                      <span className={`px-3 py-1 rounded-full text-xs font-bold ${\n                        activeDiagnosis.severity === 'severe' \n                          ? 'bg-rose-100 text-rose-800' \n                          : 'bg-amber-100 text-amber-800'\n                      }`}>\n                        {activeDiagnosis.severity === 'severe' ? t('doctor.severe') : t('doctor.moderate')}\n                      </span>\n                    </div>\n                  </div>\n\n                  <h3 className=\"text-2xl sm:text-3xl font-black text-forest-950\">\n                    {activeDiagnosis.name[currentLang] || activeDiagnosis.name.en}\n                  </h3>\n\n                  <p className=\"text-xs text-gray-600 font-medium mt-1 leading-relaxed\">\n                    {activeDiagnosis.visualDescription[currentLang] || activeDiagnosis.visualDescription.en}\n                  </p>\n                </div>\n\n                {/* Organic / Biological Remedy */}\n                <div className=\"p-5 rounded-2xl bg-forest-50/70 border border-forest-200\">\n                  <div className=\"flex items-center gap-2 text-forest-900 font-bold text-sm mb-1.5\">\n                    <ShieldCheck className=\"w-5 h-5 text-forest-700\" />\n                    <span>{t('doctor.organicRemedy')}</span>\n                  </div>\n                  <p className=\"text-xs text-gray-800 font-medium leading-relaxed\">\n                    {activeDiagnosis.organicRemedy[currentLang] || activeDiagnosis.organicRemedy.en}\n                  </p>\n                </div>\n\n                {/* Chemical Treatment Prescription */}\n                <div className=\"p-5 rounded-2xl bg-amber-50/70 border border-amber-200\">\n                  <div className=\"flex items-center gap-2 text-amber-950 font-bold text-sm mb-1.5\">\n                    <FlaskConical className=\"w-5 h-5 text-amber-700\" />\n                    <span>{t('doctor.chemicalTreatment')}</span>\n                  </div>\n                  <p className=\"text-xs text-amber-900 font-medium leading-relaxed\">\n                    {activeDiagnosis.chemicalTreatment[currentLang] || activeDiagnosis.chemicalTreatment.en}\n                  </p>\n                </div>\n\n                {/* Cultural & Preventive Measures */}\n                <div className=\"p-5 rounded-2xl bg-gray-50 border border-gray-200\">\n                  <div className=\"flex items-center gap-2 text-gray-900 font-bold text-sm mb-1.5\">\n                    <Sparkles className=\"w-5 h-5 text-forest-700\" />\n                    <span>{t('doctor.preventiveMeasures')}</span>\n                  </div>\n                  <p className=\"text-xs text-gray-700 font-medium leading-relaxed\">\n                    {activeDiagnosis.preventiveMeasures[currentLang] || activeDiagnosis.preventiveMeasures.en}\n                  </p>\n                </div>\n\n                {/* Mandatory Safety Precaution */}\n                <div className=\"flex items-start gap-2.5 p-3.5 rounded-xl bg-gray-100 text-gray-600 text-[11px] font-medium leading-normal\">\n                  <Info className=\"w-4 h-4 text-gray-500 shrink-0 mt-0.5\" />\n                  <span>{t('doctor.precautionNote')}</span>\n                </div>\n\n              </div>\n            ) : (\n              <div className=\"bg-white rounded-3xl p-12 border border-forest-100 shadow-card text-center space-y-3\">\n                <Stethoscope className=\"w-12 h-12 text-forest-300 mx-auto\" />\n                <h3 className=\"text-lg font-bold text-gray-800\">No Crop Diagnosed Yet</h3>\n                <p className=\"text-xs text-gray-500 max-w-sm mx-auto\">\n                  Select your crop and observable field symptoms on the left to generate certified organic and scientific chemical treatments.\n                </p>\n              </div>\n            )}\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\CropDoctor.jsx"}}]}
