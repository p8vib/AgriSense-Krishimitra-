{"step_index":175,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T06:00:33Z","model":"gemini-3.8-flash-high","input_tokens":3783,"cache_read_tokens":96072,"output_tokens":2860,"thinking":"Initial focus is on constructing the input form components, specifically `CropRecommender.jsx` and `FarmingPlanModal.jsx`. The input form will incorporate sliders and selectors for region/climate zone, soil type, and soil nutrients/pH. Soil nutrient sliders will handle Nitrogen and Phosphorus, with specified ranges.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React from 'react';\nimport { useLanguage } from '../context/LanguageContext';\nimport { \n  X, \n  CheckCircle, \n  Calendar, \n  AlertTriangle, \n  Droplet, \n  Wheat, \n  Sparkles, \n  Layers,\n  Clock,\n  Printer\n} from 'lucide-react';\n\nexport default function FarmingPlanModal({ crop, onClose }) {\n  const { currentLang, t } = useLanguage();\n\n  if (!crop) return null;\n\n  const cropName = crop.name[currentLang] || crop.name.en;\n  const seedRate = crop.seedRate[currentLang] || crop.seedRate.en;\n  const pestAlert = crop.pestAlerts[currentLang] || crop.pestAlerts.en;\n  const irrigationGuide = crop.irrigationGuide[currentLang] || crop.irrigationGuide.en;\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-sm overflow-y-auto animate-in fade-in duration-200\">\n      <div \n        className=\"bg-white rounded-3xl max-w-3xl w-full shadow-2xl border border-forest-100 overflow-hidden my-8 relative max-h-[90vh] flex flex-col\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Modal Header */}\n        <div className=\"relative bg-gradient-to-r from-forest-900 to-forest-800 text-white p-6 sm:p-8\">\n          <button\n            onClick={onClose}\n            className=\"absolute top-5 right-5 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors\"\n            aria-label=\"Close\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n\n          <div className=\"flex items-center gap-2 text-amber-300 text-xs font-bold uppercase tracking-wider mb-2\">\n            <Sparkles className=\"w-4 h-4\" />\n            <span>{t('planModal.title')}</span>\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n            <div>\n              <h2 className=\"text-2xl sm:text-3xl font-black\">{cropName}</h2>\n              <p className=\"text-forest-200 text-sm mt-1\">\n                {crop.category} • {crop.yieldEstimate}\n              </p>\n            </div>\n            \n            <button\n              onClick={handlePrint}\n              className=\"no-print inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-bold transition-all\"\n            >\n              <Printer className=\"w-4 h-4\" />\n              <span>Print Plan</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Modal Scrollable Body */}\n        <div className=\"p-6 sm:p-8 overflow-y-auto space-y-6 text-gray-800\">\n          \n          {/* Seed Rate & Water Requirement Highlights */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"p-4 rounded-2xl bg-forest-50 border border-forest-200\">\n              <div className=\"flex items-center gap-2 text-forest-800 font-bold text-sm mb-1\">\n                <Wheat className=\"w-4 h-4 text-forest-700\" />\n                <span>{t('planModal.seedRate')}</span>\n              </div>\n              <p className=\"text-xs text-gray-700 font-medium leading-relaxed\">\n                {seedRate}\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-2xl bg-amber-50 border border-amber-200\">\n              <div className=\"flex items-center gap-2 text-amber-900 font-bold text-sm mb-1\">\n                <Droplet className=\"w-4 h-4 text-amber-700\" />\n                <span>{t('planModal.irrigationGuide')}</span>\n              </div>\n              <p className=\"text-xs text-gray-700 font-medium leading-relaxed\">\n                {irrigationGuide}\n              </p>\n            </div>\n          </div>\n\n          {/* Cultivation Timeline Milestones */}\n          <div>\n            <h3 className=\"text-base font-bold text-forest-950 flex items-center gap-2 mb-4\">\n              <Calendar className=\"w-5 h-5 text-forest-700\" />\n              <span>{t('planModal.cultivationPhases')}</span>\n            </h3>\n\n            <div className=\"space-y-3 relative before:absolute before:inset-0 before:left-3 before:w-0.5 before:bg-forest-200\">\n              {crop.timeline.map((step, idx) => (\n                <div key={idx} className=\"relative pl-8 flex items-start gap-3\">\n                  <div className=\"absolute left-1.5 top-1.5 w-3.5 h-3.5 rounded-full bg-forest-700 border-2 border-white shadow-sm\" />\n                  <div className=\"bg-gray-50 hover:bg-forest-50/50 p-3.5 rounded-xl border border-gray-200/80 w-full transition-colors\">\n                    <span className=\"text-xs font-bold text-forest-900 block mb-0.5\">\n                      {step.phase}\n                    </span>\n                    <p className=\"text-xs text-gray-600 leading-relaxed font-medium\">\n                      {step.action[currentLang] || step.action.en}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Fertilizer Schedule */}\n          <div>\n            <h3 className=\"text-base font-bold text-forest-950 flex items-center gap-2 mb-3\">\n              <Layers className=\"w-5 h-5 text-forest-700\" />\n              <span>{t('planModal.fertilizerSchedule')}</span>\n            </h3>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n              <div className=\"p-3.5 rounded-xl bg-forest-50/60 border border-forest-200 text-xs\">\n                <span className=\"font-bold text-forest-900 block mb-1 text-[11px] uppercase tracking-wider\">\n                  {t('planModal.basal')}\n                </span>\n                <p className=\"text-gray-700 font-medium\">\n                  {crop.fertilizerSchedule.basal[currentLang] || crop.fertilizerSchedule.basal.en}\n                </p>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl bg-forest-50/60 border border-forest-200 text-xs\">\n                <span className=\"font-bold text-forest-900 block mb-1 text-[11px] uppercase tracking-wider\">\n                  {t('planModal.topDressing1')}\n                </span>\n                <p className=\"text-gray-700 font-medium\">\n                  {crop.fertilizerSchedule.top1[currentLang] || crop.fertilizerSchedule.top1.en}\n                </p>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl bg-forest-50/60 border border-forest-200 text-xs\">\n                <span className=\"font-bold text-forest-900 block mb-1 text-[11px] uppercase tracking-wider\">\n                  {t('planModal.topDressing2')}\n                </span>\n                <p className=\"text-gray-700 font-medium\">\n                  {crop.fertilizerSchedule.top2[currentLang] || crop.fertilizerSchedule.top2.en}\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Pest Alert Callout */}\n          <div className=\"p-4 rounded-2xl bg-rose-50 border border-rose-200 flex items-start gap-3\">\n            <AlertTriangle className=\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\" />\n            <div>\n              <span className=\"text-xs font-bold text-rose-900 block mb-0.5\">\n                {t('planModal.pestAlerts')}\n              </span>\n              <p className=\"text-xs text-rose-800 leading-relaxed font-medium\">\n                {pestAlert}\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 sm:p-6 bg-gray-50 border-t border-gray-100 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-6 py-2.5 rounded-xl bg-forest-900 hover:bg-forest-800 text-white font-bold text-sm shadow transition-colors min-h-[46px]\"\n          >\n            {t('planModal.close')}\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\FarmingPlanModal.jsx"}}]}
{"step_index":176,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-21T06:00:56Z","content":"Created At: 2026-11-21T11:30:56+05:30\nCompleted At: 2026-11-21T11:30:56+05:30\nCreated At: 2026-11-21T11:30:56+05:30\nCompleted At: 2026-11-21T11:30:56+05:30\nCreated file."}
{"step_index":177,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T06:00:57Z","model":"gemini-3.8-flash-high","input_tokens":2920,"cache_read_tokens":99871,"output_tokens":6767,"thinking":"Considering how to structure the crop recommendation algorithm, based on the input parameters of season, climate zone, soil type, and nutrient levels. The algorithm will evaluate crops against these user-provided inputs to determine suitability. I'll need to define how to score or rank the crops based on these factors to generate a recommendation.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState, useMemo } from 'react';\nimport { useLanguage } from '../context/LanguageContext';\nimport { cropsDatabase } from '../data/cropsData';\nimport FarmingPlanModal from './FarmingPlanModal';\nimport { \n  Sprout, \n  RotateCcw, \n  CheckCircle2, \n  Droplet, \n  TrendingUp, \n  ExternalLink, \n  Layers, \n  Sliders, \n  Sparkles,\n  Info\n} from 'lucide-react';\nimport { \n  ResponsiveContainer, \n  RadarChart, \n  PolarGrid, \n  PolarAngleAxis, \n  PolarRadiusAxis, \n  Radar, \n  Legend, \n  Tooltip \n} from 'recharts';\n\nexport default function CropRecommender() {\n  const { currentLang, t } = useLanguage();\n\n  // Form input state\n  const [climateZone, setClimateZone] = useState('subtropical');\n  const [soilType, setSoilType] = useState('alluvial');\n  const [nitrogen, setNitrogen] = useState(100);\n  const [phosphorus, setPhosphorus] = useState(55);\n  const [potassium, setPotassium] = useState(50);\n  const [phLevel, setPhLevel] = useState(6.8);\n  const [waterAvailability, setWaterAvailability] = useState('canal');\n  const [season, setSeason] = useState('rabi');\n\n  // Active modal crop\n  const [selectedCropForPlan, setSelectedCropForPlan] = useState(null);\n\n  // Reset to balanced defaults\n  const handleReset = () => {\n    setClimateZone('subtropical');\n    setSoilType('alluvial');\n    setNitrogen(90);\n    setPhosphorus(50);\n    setPotassium(45);\n    setPhLevel(6.8);\n    setWaterAvailability('canal');\n    setSeason('rabi');\n  };\n\n  // Agronomic Suitability Engine\n  const rankedCrops = useMemo(() => {\n    const scored = cropsDatabase.map(crop => {\n      let score = 0;\n\n      // 1. Season Alignment (Max 30 pts)\n      if (crop.seasons.includes(season)) {\n        score += 30;\n      } else {\n        score += 8;\n      }\n\n      // 2. Soil Type Compatibility (Max 20 pts)\n      if (crop.soilTypes.includes(soilType)) {\n        score += 20;\n      } else {\n        score += 7;\n      }\n\n      // 3. Climate Zone Fit (Max 15 pts)\n      if (crop.climateZones.includes(climateZone)) {\n        score += 15;\n      } else {\n        score += 6;\n      }\n\n      // 4. Soil Nutrients N-P-K match (Max 20 pts)\n      const midN = (crop.nRange[0] + crop.nRange[1]) / 2;\n      const midP = (crop.pRange[0] + crop.pRange[1]) / 2;\n      const midK = (crop.kRange[0] + crop.kRange[1]) / 2;\n\n      const nDiff = Math.abs(nitrogen - midN) / 100;\n      const pDiff = Math.abs(phosphorus - midP) / 70;\n      const kDiff = Math.abs(potassium - midK) / 80;\n\n      const nScore = Math.max(0, 7 * (1 - nDiff));\n      const pScore = Math.max(0, 7 * (1 - pDiff));\n      const kScore = Math.max(0, 6 * (1 - kDiff));\n      score += (nScore + pScore + kScore);\n\n      // 5. pH Tolerance (Max 10 pts)\n      if (phLevel >= crop.phRange[0] && phLevel <= crop.phRange[1]) {\n        score += 10;\n      } else {\n        const phDist = Math.min(\n          Math.abs(phLevel - crop.phRange[0]), \n          Math.abs(phLevel - crop.phRange[1])\n        );\n        score += Math.max(0, 10 - phDist * 6);\n      }\n\n      // 6. Water feasibility (Max 5 pts)\n      if (waterAvailability === 'drip' || crop.waterTypes.includes(waterAvailability)) {\n        score += 5;\n      } else {\n        score += 2;\n      }\n\n      // Final percentage normalized to 65% - 98%\n      const matchPercentage = Math.min(98, Math.max(62, Math.round(score)));\n\n      return {\n        ...crop,\n        matchPercentage\n      };\n    });\n\n    return scored.sort((a, b) => b.matchPercentage - a.matchPercentage);\n  }, [season, soilType, climateZone, nitrogen, phosphorus, potassium, phLevel, waterAvailability]);\n\n  // Top recommended crop for radar comparison\n  const topCrop = rankedCrops[0];\n\n  // Radar chart data: User's NPK vs Ideal crop NPK\n  const radarData = useMemo(() => {\n    if (!topCrop) return [];\n    const idealN = (topCrop.nRange[0] + topCrop.nRange[1]) / 2;\n    const idealP = (topCrop.pRange[0] + topCrop.pRange[1]) / 2;\n    const idealK = (topCrop.kRange[0] + topCrop.kRange[1]) / 2;\n    const idealPH = ((topCrop.phRange[0] + topCrop.phRange[1]) / 2) * 15; // Scaled for radar\n    const userPHScaled = phLevel * 15;\n\n    return [\n      { parameter: 'Nitrogen (N)', current: nitrogen, optimal: Math.round(idealN) },\n      { parameter: 'Phosphorus (P)', current: phosphorus, optimal: Math.round(idealP) },\n      { parameter: 'Potassium (K)', current: potassium, optimal: Math.round(idealK) },\n      { parameter: 'pH (x15)', current: Math.round(userPHScaled), optimal: Math.round(idealPH) },\n    ];\n  }, [topCrop, nitrogen, phosphorus, potassium, phLevel]);\n\n  return (\n    <section id=\"recommender\" className=\"py-16 sm:py-20 bg-cream-50/60 border-t border-forest-100\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Section Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-12\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-forest-100 text-forest-900 text-xs font-bold uppercase tracking-wider mb-3\">\n            <Sprout className=\"w-4 h-4 text-forest-700\" />\n            <span>AI Agronomic Engine</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-black text-forest-950 tracking-tight\">\n            {t('recommender.title')}\n          </h2>\n          <p className=\"mt-3 text-base text-gray-600 font-medium\">\n            {t('recommender.subtitle')}\n          </p>\n        </div>\n\n        {/* Two-Column Grid: Form Controls on Left, Results & Radar on Right */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Form Controls (Sliders & Selectors) */}\n          <div className=\"lg:col-span-5 bg-white p-6 sm:p-7 rounded-3xl border border-forest-100 shadow-card space-y-5\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-gray-100\">\n              <span className=\"font-bold text-gray-900 text-base flex items-center gap-2\">\n                <Sliders className=\"w-5 h-5 text-forest-700\" />\n                Parameters\n              </span>\n              <button\n                onClick={handleReset}\n                className=\"flex items-center gap-1.5 text-xs font-bold text-gray-500 hover:text-amber-700 transition-colors\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>{t('recommender.reset')}</span>\n              </button>\n            </div>\n\n            {/* Target Season Selection */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5\">\n                {t('recommender.season')}\n              </label>\n              <div className=\"grid grid-cols-3 gap-2\">\n                {[\n                  { id: 'kharif', label: t('recommender.kharif') },\n                  { id: 'rabi', label: t('recommender.rabi') },\n                  { id: 'zaid', label: t('recommender.zaid') },\n                ].map(s => (\n                  <button\n                    key={s.id}\n                    onClick={() => setSeason(s.id)}\n                    className={`px-3 py-2.5 rounded-xl text-xs font-bold transition-all border ${\n                      season === s.id\n                        ? 'bg-forest-900 text-white border-forest-900 shadow-sm'\n                        : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-forest-50'\n                    }`}\n                  >\n                    {s.label.split(' ')[0]}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Climate Zone & Soil Type Dropdowns */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1\">\n                  {t('recommender.climateZone')}\n                </label>\n                <select\n                  value={climateZone}\n                  onChange={(e) => setClimateZone(e.target.value)}\n                  className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-gray-800 focus:ring-2 focus:ring-forest-600 focus:outline-none\"\n                >\n                  <option value=\"subtropical\">{t('recommender.subtropical')}</option>\n                  <option value=\"semiarid\">{t('recommender.semiarid')}</option>\n                  <option value=\"coastal\">{t('recommender.coastal')}</option>\n                  <option value=\"hill\">{t('recommender.hill')}</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1\">\n                  {t('recommender.soilType')}\n                </label>\n                <select\n                  value={soilType}\n                  onChange={(e) => setSoilType(e.target.value)}\n                  className=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2.5 text-xs font-semibold text-gray-800 focus:ring-2 focus:ring-forest-600 focus:outline-none\"\n                >\n                  <option value=\"alluvial\">{t('recommender.alluvial')}</option>\n                  <option value=\"clay\">{t('recommender.clay')}</option>\n                  <option value=\"loamy\">{t('recommender.loamy')}</option>\n                  <option value=\"sandy\">{t('recommender.sandy')}</option>\n                  <option value=\"laterite\">{t('recommender.laterite')}</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Nitrogen Slider */}\n            <div>\n              <div className=\"flex justify-between items-center text-xs font-bold mb-1\">\n                <span className=\"text-gray-700\">{t('recommender.nitrogen')}</span>\n                <span className=\"text-forest-900 bg-forest-100 px-2 py-0.5 rounded-md font-mono\">\n                  {nitrogen} kg/ha\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"160\"\n                value={nitrogen}\n                onChange={(e) => setNitrogen(Number(e.target.value))}\n                className=\"w-full h-2 bg-gray-200 rounded-lg cursor-pointer\"\n              />\n            </div>\n\n            {/* Phosphorus Slider */}\n            <div>\n              <div className=\"flex justify-between items-center text-xs font-bold mb-1\">\n                <span className=\"text-gray-700\">{t('recommender.phosphorus')}</span>\n                <span className=\"text-forest-900 bg-forest-100 px-2 py-0.5 rounded-md font-mono\">\n                  {phosphorus} kg/ha\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"120\"\n                value={phosphorus}\n                onChange={(e) => setPhosphorus(Number(e.target.value))}\n                className=\"w-full h-2 bg-gray-200 rounded-lg cursor-pointer\"\n              />\n            </div>\n\n            {/* Potassium Slider */}\n            <div>\n              <div className=\"flex justify-between items-center text-xs font-bold mb-1\">\n                <span className=\"text-gray-700\">{t('recommender.potassium')}</span>\n                <span className=\"text-forest-900 bg-forest-100 px-2 py-0.5 rounded-md font-mono\">\n                  {potassium} kg/ha\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"140\"\n                value={potassium}\n                onChange={(e) => setPotassium(Number(e.target.value))}\n                className=\"w-full h-2 bg-gray-200 rounded-lg cursor-pointer\"\n              />\n            </div>\n\n            {/* Soil pH Slider */}\n            <div>\n              <div className=\"flex justify-between items-center text-xs font-bold mb-1\">\n                <span className=\"text-gray-700\">{t('recommender.phLevel')}</span>\n                <span className={`px-2 py-0.5 rounded-md font-mono font-bold ${\n                  phLevel < 6.0 ? 'bg-amber-100 text-amber-800' :\n                  phLevel > 7.5 ? 'bg-blue-100 text-blue-800' :\n                  'bg-emerald-100 text-emerald-800'\n                }`}>\n                  pH {phLevel.toFixed(1)} {phLevel < 6.0 ? '(Acidic)' : phLevel > 7.5 ? '(Alkaline)' : '(Neutral)'}\n                </span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"4.5\"\n                max=\"8.5\"\n                step=\"0.1\"\n                value={phLevel}\n                onChange={(e) => setPhLevel(Number(e.target.value))}\n                className=\"w-full h-2 bg-gray-200 rounded-lg cursor-pointer\"\n              />\n            </div>\n\n            {/* Water Availability Selector */}\n            <div>\n              <label className=\"block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5\">\n                {t('recommender.waterAvailability')}\n              </label>\n              <div className=\"grid grid-cols-3 gap-2\">\n                {[\n                  { id: 'rainfed', label: t('recommender.rainfed') },\n                  { id: 'canal', label: t('recommender.canal') },\n                  { id: 'drip', label: t('recommender.drip') },\n                ].map(w => (\n                  <button\n                    key={w.id}\n                    onClick={() => setWaterAvailability(w.id)}\n                    className={`px-2 py-2 rounded-xl text-[11px] font-bold transition-all border text-center ${\n                      waterAvailability === w.id\n                        ? 'bg-amber-600 text-white border-amber-600 shadow-sm'\n                        : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100'\n                    }`}\n                  >\n                    {w.label.split(' ')[0]}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n          </div>\n\n          {/* Right Column: Dynamic Output Dashboard & Radar Chart */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            \n            {/* Radar Comparison Card */}\n            <div className=\"bg-white p-5 sm:p-6 rounded-3xl border border-forest-100 shadow-card\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3\">\n                <div>\n                  <h3 className=\"text-sm font-bold text-gray-900\">\n                    {t('recommender.radarTitle')}\n                  </h3>\n                  <p className=\"text-xs text-forest-700 font-medium\">\n                    Top Match Target: <span className=\"font-bold\">{topCrop?.name[currentLang] || topCrop?.name.en}</span>\n                  </p>\n                </div>\n                <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                  {topCrop?.matchPercentage}% Agronomic Fit\n                </span>\n              </div>\n\n              <div className=\"h-60 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <RadarChart data={radarData} margin={{ top: 10, right: 25, bottom: 10, left: 25 }}>\n                    <PolarGrid stroke=\"#E5E7EB\" />\n                    <PolarAngleAxis dataKey=\"parameter\" tick={{ fontSize: 11, fill: '#374151', fontWeight: 600 }} />\n                    <PolarRadiusAxis angle={30} domain={[0, 160]} tick={{ fontSize: 9, fill: '#9CA3AF' }} />\n                    <Radar \n                      name=\"Your Soil Profile\" \n                      dataKey=\"current\" \n                      stroke=\"#d97706\" \n                      fill=\"#d97706\" \n                      fillOpacity={0.35} \n                    />\n                    <Radar \n                      name=\"Ideal Crop Profile\" \n                      dataKey=\"optimal\" \n                      stroke=\"#1b4332\" \n                      fill=\"#1b4332\" \n                      fillOpacity={0.25} \n                    />\n                    <Legend wrapperStyle={{ fontSize: '11px', paddingTop: '10px' }} />\n                    <Tooltip />\n                  </RadarChart>\n                </ResponsiveContainer>\n              </div>\n            </div>\n\n            {/* Top 3 Ranked Crops Cards */}\n            <div>\n              <div className=\"flex items-center justify-between mb-4\">\n                <h3 className=\"text-lg font-bold text-forest-950 flex items-center gap-2\">\n                  <Sparkles className=\"w-5 h-5 text-amber-500\" />\n                  <span>{t('recommender.topResults')}</span>\n                </h3>\n                <span className=\"text-xs text-gray-500 font-medium\">\n                  Sorted by suitability score\n                </span>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                {rankedCrops.slice(0, 4).map((crop, idx) => {\n                  const cropName = crop.name[currentLang] || crop.name.en;\n                  const isTopRanked = idx === 0;\n\n                  return (\n                    <div\n                      key={crop.id}\n                      className={`group bg-white rounded-2xl border overflow-hidden shadow-card hover:shadow-elevated transition-all flex flex-col justify-between ${\n                        isTopRanked \n                          ? 'border-2 border-forest-600 ring-2 ring-forest-100' \n                          : 'border-forest-100 hover:border-forest-300'\n                      }`}\n                    >\n                      {/* Image header with fallback */}\n                      <div className=\"relative h-44 w-full bg-forest-900 overflow-hidden\">\n                        <img\n                          src={crop.image}\n                          alt={cropName}\n                          onError={(e) => {\n                            e.target.style.display = 'none';\n                          }}\n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                        />\n                        <div className={`absolute inset-0 bg-gradient-to-t ${crop.fallbackGradient} opacity-60`} />\n\n                        {/* Top Badges */}\n                        <div className=\"absolute top-3 left-3 right-3 flex justify-between items-center\">\n                          <span className={`px-2.5 py-1 rounded-full text-xs font-black shadow-md ${\n                            crop.matchPercentage >= 90\n                              ? 'bg-emerald-500 text-white'\n                              : crop.matchPercentage >= 80\n                              ? 'bg-amber-500 text-white'\n                              : 'bg-gray-700 text-white'\n                          }`}>\n                            {crop.matchPercentage}% {t('recommender.matchBadge')}\n                          </span>\n\n                          <span className=\"px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[11px] font-bold\">\n                            {crop.category}\n                          </span>\n                        </div>\n\n                        {/* Crop Name Overlay */}\n                        <div className=\"absolute bottom-3 left-3 right-3 text-white\">\n                          <h4 className=\"text-xl font-black drop-shadow-md\">\n                            {cropName}\n                          </h4>\n                        </div>\n                      </div>\n\n                      {/* Card Content Details */}\n                      <div className=\"p-4 space-y-3 flex-1 flex flex-col justify-between\">\n                        <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                          <div className=\"bg-gray-50 p-2.5 rounded-xl border border-gray-100\">\n                            <span className=\"text-gray-500 font-semibold block text-[10px] uppercase\">\n                              {t('recommender.expectedYield')}\n                            </span>\n                            <span className=\"font-bold text-gray-900 mt-0.5 block\">\n                              {crop.yieldEstimate}\n                            </span>\n                          </div>\n\n                          <div className=\"bg-gray-50 p-2.5 rounded-xl border border-gray-100\">\n                            <span className=\"text-gray-500 font-semibold block text-[10px] uppercase\">\n                              {t('recommender.waterReq')}\n                            </span>\n                            <span className=\"font-bold text-forest-800 mt-0.5 block flex items-center gap-1\">\n                              <Droplet className=\"w-3.5 h-3.5 text-blue-500\" />\n                              {crop.waterRequirement}\n                            </span>\n                          </div>\n\n                          <div className=\"bg-gray-50 p-2.5 rounded-xl border border-gray-100\">\n                            <span className=\"text-gray-500 font-semibold block text-[10px] uppercase\">\n                              {t('recommender.marketDemand')}\n                            </span>\n                            <span className=\"font-bold text-amber-700 mt-0.5 block flex items-center gap-1\">\n                              <TrendingUp className=\"w-3.5 h-3.5\" />\n                              {crop.marketDemand}\n                            </span>\n                          </div>\n\n                          <div className=\"bg-gray-50 p-2.5 rounded-xl border border-gray-100\">\n                            <span className=\"text-gray-500 font-semibold block text-[10px] uppercase\">\n                              {t('recommender.profitIndex')}\n                            </span>\n                            <span className=\"font-bold text-emerald-700 mt-0.5 block\">\n                              {crop.profitIndex} / 100\n                            </span>\n                          </div>\n                        </div>\n\n                        {/* CTA button (min 48px height) */}\n                        <button\n                          onClick={() => setSelectedCropForPlan(crop)}\n                          className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-forest-900 hover:bg-forest-800 text-white font-bold text-xs shadow transition-all min-h-[48px] active:scale-[0.98]\"\n                        >\n                          <span>{t('recommender.viewPlan')}</span>\n                          <ExternalLink className=\"w-4 h-4 text-amber-400\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Farming Plan Modal */}\n      {selectedCropForPlan && (\n        <FarmingPlanModal\n          crop={selectedCropForPlan}\n          onClose={() => setSelectedCropForPlan(null)}\n        />\n      )}\n    </section>\n  );\n}\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\components\\CropRecommender.jsx"}}]}
