{"step_index":161,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-21T05:55:19Z","model":"gemini-3.8-flash-high","input_tokens":10769,"cache_read_tokens":53853,"output_tokens":694,"tool_calls":[{"name":"write_file","args":{"Content":"import React, { createContext, useContext, useState, useEffect } from 'react';\nimport { translations } from '../data/translations';\n\nconst LanguageContext = createContext();\n\nexport const languages = [\n  { code: 'en', label: 'English', native: 'English', flag: '🇬🇧' },\n  { code: 'hi', label: 'Hindi', native: 'हिंदी', flag: '🇮🇳' },\n  { code: 'as', label: 'Assamese', native: 'অসমীয়া', flag: '🇮🇳' },\n  { code: 'es', label: 'Spanish', native: 'Español', flag: '🇪🇸' },\n];\n\nexport const LanguageProvider = ({ children }) => {\n  const [currentLang, setCurrentLang] = useState(() => {\n    return localStorage.getItem('agrisense_lang') || 'en';\n  });\n\n  useEffect(() => {\n    localStorage.setItem('agrisense_lang', currentLang);\n    document.documentElement.lang = currentLang;\n  }, [currentLang]);\n\n  // Nested translation helper with fallback\n  const t = (path) => {\n    const keys = path.split('.');\n    \n    // Look up in current language\n    let value = translations[currentLang];\n    for (const key of keys) {\n      if (value && typeof value === 'object' && key in value) {\n        value = value[key];\n      } else {\n        value = undefined;\n        break;\n      }\n    }\n    \n    // Fallback to English if not found\n    if (value === undefined) {\n      let fallbackValue = translations['en'];\n      for (const key of keys) {\n        if (fallbackValue && typeof fallbackValue === 'object' && key in fallbackValue) {\n          fallbackValue = fallbackValue[key];\n        } else {\n          return path; // Return key path if missing\n        }\n      }\n      return fallbackValue;\n    }\n    \n    return value;\n  };\n\n  return (\n    <LanguageContext.Provider value={{ currentLang, setCurrentLang, t, languages }}>\n      {children}\n    </LanguageContext.Provider>\n  );\n};\n\nexport const useLanguage = () => {\n  const context = useContext(LanguageContext);\n  if (!context) {\n    throw new Error('useLanguage must be used within a LanguageProvider');\n  }\n  return context;\n};\n","Overwrite":true,"Path":"C:\\Users\\abasu\\.gemini\\antigravity\\scratch\\agrisense\\src\\context\\LanguageContext.jsx"}}]}
